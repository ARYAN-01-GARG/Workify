PORT=3001
HOST=0.0.0.0
NODE_ENV=development

JWT_SECRET=your_jwt_secret_min_32_chars_for_security
JWT_EXPIRES_IN=30d

# Test OTP bypass - set to 'true' ONLY in dev/staging environments
ENABLE_TEST_OTP=false

# CORS (comma-separated for multiple origins)
CORS_URLS=http://localhost:3000

GOOGLE_CLIENT_ID=clientId
GOOGLE_CLIENT_SECRET=secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/callback/google

DATABASE_URL=mongoUrl

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT="465"
SMTP_USER="username"
SMTP_PASSWORD="password"
SMTP_FROM="from@example.com"
SMTP_FROM_NAME="From Name"

# Gemini
GEMINI_API_KEY=your_gemini_api_key 
GEMINI_BASE_URL=https://api.gemini.com/v1